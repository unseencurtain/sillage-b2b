# Offline image enrichment / wholesale-perfumes.eu + Brasty feed downloads.
# Copy to .env and fill in. Never commit .env.

# wholesale-perfumes.eu — HTTP Basic uses email + API token (not the portal password).
WHOLESALE_PERFUMES_USER=
WHOLESALE_PERFUMES_TOKEN=
# Optional: e-shop login password for browser experiments in this folder only.
WHOLESALE_PERFUMES_PASSWORD=
WHOLESALE_PERFUMES_CATALOG_URL=https://www.wholesale-perfumes.eu/xml/catalog/LovelyXml/en
WHOLESALE_PERFUMES_STOCK_URL=https://www.wholesale-perfumes.eu/xml/store/LovelyXml/EUR

# Public base for host_override_images.py rewrites (no trailing slash).
# Aliases: LPS_MEDIA_BASE_URL, IMAGE_HOST_BASE_URL, PUBLIC_URL_BASE
LPS_MEDIA_BASE_URL=https://images.prinscosmetic.eu

# Brasty — feed URLs and/or portal login for Playwright / download experiments
BRASTY_PRODUCT_FEED_URL=
BRASTY_AVAILABILITY_FEED_URL=
BRASTY_EMAIL=
BRASTY_PASSWORD=
