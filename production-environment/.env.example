# Single env for the whole stack. Copy to production-environment/.env (gitignored).
#   cp .env.example .env
#   # change-me passwords + optional domains; vendor keys can wait for dashboard Secrets
#   docker network create ecom_network && docker network create redis_network
#   touch sillage-core/data/secrets.overlay.env
#   docker compose --env-file .env up -d
#
# Domains below are local/staging placeholders. Override for a real VPS, or pass
# --shop/--dash/--images to deploy-vps.sh (which also reads these when omitted).
# After login, Shop URL + Image CDN are editable in Settings; wholesale-perfumes keys on Secrets.

# ── Docker images ────────────────────────────────────────────────────────────
SILLAGE_CORE_IMAGE=unseencurtain/sillage-b2b:latest
WORDPRESS_IMAGE=unseencurtain/sillage-wordpress:latest
MARIADB_IMAGE=mariadb:latest
VALKEY_IMAGE=valkey/valkey:8-alpine
LPS_MEDIA_IMAGE=nginx:alpine
CADDY_IMAGE=caddy:2-alpine

# ── Host paths (relative to this compose file unless absolute) ───────────────
DATA_DIR=./ecom_sites/data
FEEDSCRATCH_DIR=../.feedscratch
SILLAGE_LOGS_DIR=./sillage-core/logs
IMAGE_OVERRIDES_FILE=./sillage-core/data/image_overrides.json
# Gitignored overlay written by dashboard Secrets UI (touch empty file before first compose up).
SILLAGE_SECRETS_FILE=./sillage-core/data/secrets.overlay.env
# Host dir Caddy serves as /robots.txt and /wp-sitemap*.xml (VPS: /home/ubuntu/ecom_sites/data/sitemaps)
SITEMAP_HOST_DIR=./ecom_sites/data/sitemaps
MARIADB_CNF=./ecom_sites/config/mariadb.cnf
# VPS (~4 GB): MARIADB_CNF=./ecom_sites/config/mariadb.vps.cnf
LPS_MEDIA_NGINX_CONF=./ecom_sites/config/nginx-lps-media.conf
PHP_INI=./ecom_sites/config/php.ini
GATEWAY_CADDYFILE=./ecom_sites/config/Caddyfile.compose

# ── Published ports (loopback by default; VPS Caddy proxies to these) ────────
DB_BIND=127.0.0.1
DB_HOST_PORT=3308
ECOM_BIND=127.0.0.1
ECOM_PORT=106
MEDIA_BIND=127.0.0.1
MEDIA_PORT=105
SILLAGE_BIND=127.0.0.1
SILLAGE_PORT=4001
GATEWAY_PORT=80

# Local browser gateway on :80 — enable with: docker compose --profile local up -d
# COMPOSE_PROFILES=local

# ── Domains (placeholders OK for local; override for public VPS) ─────────────
SHOP_DOMAIN=localhost
DASH_DOMAIN=localhost
IMAGES_DOMAIN=localhost
# Public shop URL for dashboard “Open in WooCommerce” / tracking (Settings can override).
WP_BASE_URL=http://127.0.0.1:106
# In-Docker WordPress hostname for finalize REST (compose sets this if unset).
WORDPRESS_INTERNAL_URL=http://wholesale-ecom
# Public image origin for tooling (Settings → Image CDN can override).
LPS_MEDIA_BASE_URL=http://127.0.0.1:105
# Optional aliases (tools / older scripts): IMAGE_HOST_BASE_URL, PUBLIC_URL_BASE

# Live shop example:
# SHOP_DOMAIN=wholesale.mirainikki.xyz
# DASH_DOMAIN=sillage-wholesale.mirainikki.xyz
# IMAGES_DOMAIN=images.prinscosmetic.eu
# WP_BASE_URL=https://wholesale.mirainikki.xyz
# LPS_MEDIA_BASE_URL=https://images.prinscosmetic.eu

# ── MariaDB / WordPress ──────────────────────────────────────────────────────
MYSQL_ROOT_PWD=change-me
MYSQL_DB=earth_wpf
MYSQL_USER=lime
MYSQL_PWD=change-me

# ── sillage-core ─────────────────────────────────────────────────────────────
NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Compose overrides DB_HOST/REDIS_URL/FIXTURES_DIR inside containers.
DB_HOST=127.0.0.1
DB_PORT=3308
DB_USER=sillage
SILLAGE_DB_PASSWORD=change-me
SILLAGE_DB=sillage_wpf
WORDPRESS_DB=earth_wpf
WP_TABLE_PREFIX=wp_
DB_CONNECTION_LIMIT=10

SILLAGE_SHARED_SECRET=generate-a-long-random-hex-string

# Optional bootstrap — prefer dashboard Secrets after first login (hot-reload).
WHOLESALE_PERFUMES_USER=
WHOLESALE_PERFUMES_TOKEN=
WHOLESALE_PERFUMES_CATALOG_URL=https://www.wholesale-perfumes.eu/xml/catalog/LovelyXml/en
WHOLESALE_PERFUMES_STOCK_URL=https://www.wholesale-perfumes.eu/xml/store/LovelyXml/EUR
WHOLESALE_PERFUMES_API_BASE_URL=https://www.wholesale-perfumes.eu/api/v1

BRASTY_PRODUCT_FEED_URL=
BRASTY_AVAILABILITY_FEED_URL=

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=generate-another-long-random-hex-string

FIXTURES_DIR=../.feedscratch
REDIS_URL=redis://127.0.0.1:6379

