# Local edge for laptop --profile local. Product photos are vendor flask_front
# URLs, not files from the retail Sillage CDN (~/ecom_sites/data/media).
:80 {
	header {
		-Server
		-Via
		-X-Powered-By
	}
	handle /robots.txt {
		root * /srv/sitemaps
		file_server
	}
	handle /wp-sitemap* {
		root * /srv/sitemaps
		file_server
	}
	reverse_proxy wholesale-ecom:80 {
		header_down -Server
		header_down -Via
		header_down -X-Powered-By
	}
}
