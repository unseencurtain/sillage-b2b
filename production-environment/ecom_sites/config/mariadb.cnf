[mariadbd]
# Sized for the ~52.7k product / ~1M postmeta row bulk import performed by sillage-core.
# Stock defaults (128M pool, 16M packet) stall that import badly.

innodb_buffer_pool_size         = 2G
innodb_log_file_size            = 512M
innodb_log_buffer_size          = 64M

# The importer builds large multi-row INSERT statements against a byte budget.
max_allowed_packet              = 64M

# 2 = flush once per second rather than fsync on every commit. Trades up to one second of
# committed transactions on host power loss for a very large bulk-write speedup. Acceptable here
# because every sync run is fully reproducible from the vendor feeds.
innodb_flush_log_at_trx_commit  = 2

innodb_flush_method             = O_DIRECT
innodb_io_capacity              = 2000
innodb_io_capacity_max          = 4000
innodb_read_io_threads          = 8
innodb_write_io_threads         = 8

max_connections                 = 200
wait_timeout                    = 28800
interactive_timeout             = 28800

sort_buffer_size                = 4M
join_buffer_size                = 4M
tmp_table_size                  = 128M
max_heap_table_size             = 128M

character-set-server            = utf8mb4
collation-server                = utf8mb4_unicode_ci
