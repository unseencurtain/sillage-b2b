# Deprecated as the primary env — prefer ../.env.example for compose/deploy.
# This file remains useful for host-side `bun run` against local ports.

# Copy to .env and fill in. Never commit .env.

NODE_ENV=production
PORT=4000
LOG_LEVEL=info

# Host-side defaults. Compose overrides DB_HOST=ecom-db and FIXTURES_DIR=/app/.feedscratch.
DB_HOST=127.0.0.1
DB_PORT=3307
DB_USER=sillage
SILLAGE_DB_PASSWORD=change-me
SILLAGE_DB=sillage
WORDPRESS_DB=earth
WP_TABLE_PREFIX=wp_

WP_BASE_URL=http://localhost
SILLAGE_SHARED_SECRET=generate-a-long-random-hex-string
# SILLAGE_PROFILE=retail
# SILLAGE_LOCK_PREFIX=sillage

# Optional fallback for sil_settings.image_cdn_base_url when the DB row is missing.
# Tools that write image_overrides.json also honour LPS_MEDIA_BASE_URL / PUBLIC_URL_BASE.
# LPS_MEDIA_BASE_URL=https://images.prinscosmetic.eu

BEAUTYFORT_USER=
BEAUTYFORT_SECRET=
BEAUTYFORT_ENDPOINT=https://www.beautyfort.com/api/soap/v4
BEAUTYFORT_TEST_MODE=false

BTS_JWT_TOKEN=
BTS_BASE_URL=https://api.btswholesaler.com/v1/api
BTS_LANGUAGE=en-US

# wholesale-perfumes.eu (SoleLuna) — HTTP Basic for XML/API.
# Username = shop login email. Token = API token from user settings (not the shop password).
WHOLESALE_PERFUMES_USER=
WHOLESALE_PERFUMES_TOKEN=
WHOLESALE_PERFUMES_CATALOG_URL=https://www.wholesale-perfumes.eu/xml/catalog/LovelyXml/en
WHOLESALE_PERFUMES_STOCK_URL=https://www.wholesale-perfumes.eu/xml/store/LovelyXml/EUR
WHOLESALE_PERFUMES_API_BASE_URL=https://www.wholesale-perfumes.eu/api/v1

# Brasty wholesale feeds (hash URLs are secrets — paste full download URL locally only)
BRASTY_PRODUCT_FEED_URL=
BRASTY_AVAILABILITY_FEED_URL=

DASHBOARD_USER=admin
DASHBOARD_PASSWORD=change-me
SESSION_SECRET=generate-another-long-random-hex-string

FIXTURES_DIR=../../.feedscratch
REDIS_URL=redis://127.0.0.1:6379
